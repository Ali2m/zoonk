# Required for anything that generates (https://vercel.com/ai-gateway).
AI_GATEWAY_API_KEY=

# Optional.
# BRIDGE_PORT=4310
# BRIDGE_PUBLIC_URL=http://localhost:4310
# BRIDGE_DATA_DIR=.data
# One gateway model id for every text task, with no fallback (default: each task's own model).
# BRIDGE_TEXT_MODEL=
# BRIDGE_IMAGE_MODEL=
